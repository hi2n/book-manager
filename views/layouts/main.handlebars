<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý sách</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 900px; margin: 30px auto; padding: 0 15px; }
    form { margin: 15px 0; display: flex; gap: 8px; flex-wrap: wrap; }
    input { padding: 6px; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    .error { color: #c00; font-weight: bold; }
    footer { margin-top: 40px; padding-top: 10px; border-top: 1px solid #ccc; text-align: center; color: #555; }
  </style>
</head>
<body>
  {{{body}}}
  <footer>{{fullName}} - MSSV: {{mssv}} - VAT áp dụng: {{vat}}%</footer>
</body>
</html>

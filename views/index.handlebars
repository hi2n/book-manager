<h1>Quản lý sách</h1>
<p>Số lần truy cập (lưu trong session trên Atlas): <b>{{visits}}</b></p>

{{#if error}}<p class="error">{{error}}</p>{{/if}}

<form method="POST" action="/books">
  <input name="code" placeholder="Mã sách (bắt đầu bằng {{prefix}})" required>
  <input name="title" placeholder="Tên sách" required>
  <input name="author" placeholder="Tác giả">
  <input name="price" type="number" min="0" placeholder="Giá gốc" required>
  <button type="submit">Thêm</button>
</form>

<table>
  <tr>
    <th>Mã</th><th>Tên</th><th>Tác giả</th><th>Giá gốc</th><th>VAT</th><th>Giá sau thuế</th>
  </tr>
  {{#each books}}
  <tr>
    <td>{{code}}</td><td>{{title}}</td><td>{{author}}</td>
    <td>{{price}}</td><td>{{vat}}%</td><td>{{priceAfterTax}}</td>
  </tr>
  {{/each}}
</table>
